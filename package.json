{
  "name": "wb-armor",
  "version": "1.1.0",
  "private": true,
  "description": "WorkBuddy / CodeBuddy reverse proxy + prompt-armor removal + multi-source OpenAI-compatible router for Codex & DeepSeek Harness (local, own assets only).",
  "type": "module",
  "scripts": {
    "up": "python -m wbarmor start",
    "down": "python -m wbarmor stop",
    "status": "python -m wbarmor status",
    "selftest": "python dev/diag_issues.py",
    "gui": "pythonw gui/app.py",
    "deploy": "python -m wbarmor deploy all",
    "armor": "python -m wbarmor adv armor status",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release.ps1"
  },
  "license": "MIT"
}
